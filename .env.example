# ===================== 运行环境 =====================
# dev: 本地开发（Chroma） / prod: 生产（PGVector）
ENVIRONMENT=dev

# ===================== 大模型配置 =====================
# DeepSeek API Key（从 https://platform.deepseek.com 获取）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 对话模型：deepseek-chat（V3）或 deepseek-reasoner（推理）
CHAT_MODEL_NAME=deepseek-chat

# ===================== 嵌入模型配置 =====================
# 本地中文嵌入模型（HuggingFace 自动下载，无需 Key）
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ===================== 重排序模型 =====================
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3

# ===================== 向量库配置 =====================
# 开发环境使用 Chroma（本地文件）
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=rag_knowledge_base

# 生产环境使用 PGVector（需先启动 PostgreSQL + pgvector 扩展）
PGVECTOR_CONNECTION_STRING=postgresql+psycopg2://postgres:password@localhost:5432/rag_db
PGVECTOR_COLLECTION_NAME=rag_knowledge_base

# ===================== 检索配置 =====================
# 混合检索返回的候选数量（送入 Reranker 前）
RETRIEVAL_TOP_K=20
# Reranker 精排后返回给 LLM 的数量
RERANK_TOP_N=3
# 拒答阈值：最高分低于此值时返回"未找到相关资料"
CONFIDENCE_THRESHOLD=0.0

# ===================== 分块配置 =====================
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# ===================== 服务配置 =====================
HOST=127.0.0.1
PORT=8000
